---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/home/Hero.astro";
import Projects from "../../components/home/Projects.astro";
import About from "../../components/home/About.astro";
import Career from "../../components/home/Career.astro";
import Offscreen from "../../components/home/Offscreen.astro";
import BlogPreview from "../../components/home/BlogPreview.astro";
import Contact from "../../components/home/Contact.astro";
import { translations } from "../../i18n/translate.js";

const t = translations.pt;
---

<Layout lang="pt">
  <Hero t={t} />
  <Projects t={t} lang="pt" />
  <About t={t} />
  <Career t={t} lang="pt" />
  <Offscreen t={t} lang="pt" />
  <BlogPreview t={t} lang="pt" />
  <Contact t={t} />
</Layout>
