---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/translate.js";
import "../styles/global.css";

const { lang = "pt", title, description } = Astro.props;
const t = translations[lang as "en" | "pt"] || translations.pt;

// Triângulos de fundo global
const TOTAL_TRIANGLES = 80;
const triangles = Array.from({ length: TOTAL_TRIANGLES }).map((_, i) => {
  const size = Math.random() * 40 + 10;
  const x = Math.random() * 1000 - 500;
  const y = Math.random() * 1000 - 500;
  const z = Math.random() * 2000 - 1000;
  const rotate = Math.random() * 360;

  return {
    "--size": `${size}px`,
    "--x": `${x}px`,
    "--y": `${y}px`,
    "--z": `${z}px`,
    "--r": `${rotate}deg`,
    "--d": `${i * -0.05}s`,
  };
});
---

<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <BaseHead lang={lang} title={title || t.meta.title} description={description || t.meta.description} />
  </head>

  <body>
    <div class="bg-aura" aria-hidden="true"></div>
    <div class="global-bg-wrap" aria-hidden="true">
      {triangles.map((style) => <div class="tri" style={style} />)}
    </div>

    <Header lang={lang} variant="home" />
    <main>
      <slot />
    </main>
    <Footer t={t} />

    <script>
      import { initReveal, keepTheme } from "../lib/client";
      import { initTracking } from "../lib/track";
      document.addEventListener("astro:page-load", () => requestAnimationFrame(() => requestAnimationFrame(initReveal)));
      keepTheme();
      // Rastreio nunca pode quebrar o site
      try { initTracking(); } catch {}
    </script>
  </body>
</html>
