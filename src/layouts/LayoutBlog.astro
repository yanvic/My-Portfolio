---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/translate.js";
import "../styles/global.css";
import "../styles/blog.css";

const { lang = "pt", title, description, type } = Astro.props;
const t = translations[lang as "en" | "pt"] || translations.pt;
---

<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <BaseHead lang={lang} title={title || t.meta.blogTitle} description={description || t.blog.archiveSubtitle} type={type} />
  </head>

  <body class="blog-body">
    <div class="bg-aura" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"><i id="prog"></i></div>

    <Header lang={lang} variant="blog" />
    <main class="wrap">
      <slot />
    </main>
    <Footer t={t} />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import { initReveal, keepTheme } from "../lib/client";
      import { initTracking } from "../lib/track";
      document.addEventListener("astro:page-load", () => requestAnimationFrame(() => requestAnimationFrame(initReveal)));
      keepTheme();
      // Rastreio nunca pode quebrar o site
      try { initTracking(); } catch {}
    </script>
  </body>
</html>
