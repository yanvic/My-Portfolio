---
import { render } from "astro:content";
import Cover from "./Cover.astro";
import Logo from "../Logo.astro";
import { getPosts, slugOf, blogBase, formatDate } from "../../lib/posts";

const { post, t } = Astro.props;
const lang = t.locale === "en-US" ? "en" : "pt";
const b = t.blog;
const { Content, headings } = await render(post);
const slug = slugOf(post.id);
const d = post.data;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${lang}`;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const all = await getPosts();
const i = all.findIndex((p) => p.id === post.id);
const newer = all[i - 1];
const older = all[i + 1];
const arrowL = '<path d="m15 18-6-6 6-6"/>';
const arrowR = '<path d="m9 18 6-6-6-6"/>';
---

<article class="reader" data-slug={slug} data-i18n={JSON.stringify({ copy: b.copy, copied: b.copied, codeCopied: b.codeCopied, linkCopied: b.linkCopied, copyFail: b.copyFail })}>
  <div class="r-head" data-animate="fade-up">
    <a class="back" href={blogBase(lang)}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowL} />{b.back}</a>
    <div class="pmeta">
      <span class="pill">{d.tag}</span>
      <span>{formatDate(d.date, t.locale, true)}</span>
      <span>{d.readTime} {b.readTime}</span>
    </div>
    <h1>{d.title}</h1>
    <p class="lead">{d.description}</p>
    <div class="byline">
      <span class="av"><Logo size={40} id="byline" /></span>
      <div><b>Yan Silva</b><small>{b.author}</small></div>
      <button class="btn ghost sm copy-link" type="button" data-track="post_copy_link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
        {b.copyLink}
      </button>
    </div>
  </div>

  <div class="r-cover" data-animate="zoom-in"><Cover slug={slug} tag={d.tag} image={d.cover} alt={d.title} /></div>

  <div class="r-grid">
    {toc.length > 0 && (
      <aside class="toc">
        <details open>
          <summary>{b.inArticle}</summary>
          <nav aria-label={b.inArticle}>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        </details>
      </aside>
    )}
    <div>
      <div class="prose"><Content /></div>

      <div class="endcard">
        <div><b>{b.endTitle}</b><p>{b.endText}</p></div>
        <div class="btns">
          <a class="btn primary" href={`${home}#contact`} data-track="post_contact">{b.endCta}</a>
          <a class="btn" href="https://linkedin.com/in/yan-silva12" target="_blank" rel="noopener" data-track="linkedin">LinkedIn</a>
        </div>
      </div>

      <nav class="pager">
        {older && (
          <a class="pn prev" data-track="post_prev" href={`${blogBase(lang)}/${slugOf(older.id)}`}>
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowL} />{b.prev}</span>
            <b>{older.data.title}</b>
          </a>
        )}
        {newer && (
          <a class="pn next" data-track="post_next" href={`${blogBase(lang)}/${slugOf(newer.id)}`}>
            <span>{b.next}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowR} /></span>
            <b>{newer.data.title}</b>
          </a>
        )}
      </nav>
    </div>
  </div>
</article>

<script>
  import { copyText, toast } from "../../lib/client";

  let cleanup: (() => void) | null = null;

  function initArticle() {
    cleanup?.();
    cleanup = null;
    const reader = document.querySelector<HTMLElement>(".reader[data-slug]");
    if (!reader) return;
    const i18n = JSON.parse(reader.dataset.i18n || "{}");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Botão copiar nos blocos de código
    reader.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
      if (pre.parentElement?.classList.contains("code")) return;
      const lang = pre.getAttribute("data-language") || "code";
      const box = document.createElement("div");
      box.className = "code";
      const bar = document.createElement("div");
      bar.className = "code-bar";
      const label = document.createElement("span");
      label.textContent = lang;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "copy-code";
      btn.dataset.track = "code_copy";
      btn.textContent = i18n.copy;
      btn.addEventListener("click", () => {
        copyText(pre.innerText).then(() => {
          toast(i18n.codeCopied);
          btn.textContent = i18n.copied;
          setTimeout(() => { btn.textContent = i18n.copy; }, 1600);
        }, () => toast(i18n.copyFail));
      });
      bar.append(label, btn);
      pre.replaceWith(box);
      box.append(bar, pre);
    });

    // Tabelas roláveis
    reader.querySelectorAll(".prose table").forEach((table) => {
      if (table.parentElement?.classList.contains("table-wrap")) return;
      const w = document.createElement("div");
      w.className = "table-wrap";
      table.replaceWith(w);
      w.appendChild(table);
    });

    reader.querySelector(".copy-link")?.addEventListener("click", () => {
      copyText(location.href.split("#")[0]).then(() => toast(i18n.linkCopied), () => toast(i18n.copyFail));
    });

    // Sumário: destaca a seção atual
    const links = Array.from(reader.querySelectorAll<HTMLAnchorElement>("[data-toc]"));
    const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
    let obs: IntersectionObserver | null = null;
    if (heads.length && "IntersectionObserver" in window) {
      obs = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (e.isIntersecting) links.forEach((a) => a.classList.toggle("on", a.dataset.toc === e.target.id));
        });
      }, { rootMargin: "-90px 0px -70% 0px" });
      heads.forEach((h) => obs!.observe(h));
    }
    links.forEach((a) => a.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById(a.dataset.toc!)?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      history.replaceState(null, "", `#${a.dataset.toc}`);
      if (matchMedia("(max-width:900px)").matches) a.closest("details")?.removeAttribute("open");
    }));
    if (matchMedia("(max-width:900px)").matches) reader.querySelector(".toc details")?.removeAttribute("open");

    // Barra de progresso de leitura
    const prog = document.getElementById("prog");
    const prose = reader.querySelector<HTMLElement>(".prose")!;
    const progress = () => {
      if (!prog) return;
      const r = prose.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const done = Math.min(1, Math.max(0, (-r.top + innerHeight * 0.4) / Math.max(1, total)));
      prog.style.transform = `scaleX(${done})`;
    };
    progress();
    addEventListener("scroll", progress, { passive: true });
    addEventListener("resize", progress);


    cleanup = () => {
      obs?.disconnect();
      removeEventListener("scroll", progress);
      removeEventListener("resize", progress);
      if (prog) prog.style.transform = "scaleX(0)";
    };
  }

  document.addEventListener("astro:page-load", initArticle);
</script>
