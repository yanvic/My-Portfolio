---
import Cover from "./Cover.astro";
import { slugOf, tagKey, blogBase, formatDate } from "../../lib/posts";

const { post, t, lang, flag } = Astro.props;
const slug = slugOf(post.id);
const d = post.data;
const text = `${d.title} ${d.description} ${d.tag}`.toLowerCase();
---

<a
  class="card-box post"
  href={`${blogBase(lang)}/${slug}`}
  data-track={`post_open:${slug}`.slice(0, 64)}
  data-tag={tagKey(d.tag)}
  data-date={d.date.toISOString().slice(0, 10)}
  data-text={text}
>
  <div class="cover"><Cover slug={slug} tag={d.tag} image={d.cover} /></div>
  <div class="body">
    <span class="flag">{flag ?? t.blog.latest}</span>
    <div class="pmeta">
      <span class="pill">{d.tag}</span>
      <span>{formatDate(d.date, t.locale)}</span>
      <span>{d.readTime} {t.blog.readTime}</span>
    </div>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <span class="more">{t.blog.read}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
  </div>
</a>
