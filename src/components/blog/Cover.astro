---
// Capa do artigo: usa a imagem do frontmatter (cover) ou uma ilustração SVG por slug/tag
import { Image } from "astro:assets";

const { slug, tag = "", image, alt = "" } = Astro.props;

const INK = "#222831";
const mono = "font-family:JetBrains Mono,monospace";
const known = ["ci-cd-do-zero", "rust-para-backend", "code-review-eficaz", "microservicos-na-pratica"];
const kind = known.includes(slug) ? slug : "generic";

const bg = {
  "ci-cd-do-zero": "#C58AFF",
  "rust-para-backend": "#FFAE8F",
  "code-review-eficaz": "#5FD9B5",
  "microservicos-na-pratica": INK,
  generic: "#91C8E4",
}[kind];

// grade de pontos
const dots = [];
for (let x = -110; x <= 510; x += 20) for (let y = 10; y <= 230; y += 20) dots.push([x, y]);

// engrenagens (rust)
function gear(cx, cy, r, teeth = 12) {
  const pts = [];
  for (let i = 0; i < teeth * 2; i++) {
    const a = (Math.PI * i) / teeth;
    const rr = i % 2 === 0 ? r : r * 0.82;
    pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
  }
  return pts.join(" ");
}
function hex(cx, cy, r) {
  return Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 3) * i + Math.PI / 6;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(" ");
}
const stages = [["build", 70], ["test", 160], ["lint", 250]];
const micro = [[90, 70, 26, "#FFAE8F"], [92, 175, 24, "#5FD9B5"], [310, 66, 24, "#FFD66B"], [318, 178, 28, "#C58AFF"], [200, 32, 16, "#5FD9B5"], [200, 212, 16, "#FFAE8F"]];
---

{image ? <Image src={image} alt={alt} widths={[400, 800, 1400]} sizes="(max-width: 760px) 100vw, 800px" /> : (
<svg viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect x="-400" width="1200" height="240" fill={bg} />
  {dots.map(([x, y]) => <circle cx={x} cy={y} r="1.6" fill="#fff" opacity=".16" />)}

  {kind === "ci-cd-do-zero" && (
    <>
      <path d="M70 120 H340" stroke={INK} stroke-opacity=".45" stroke-width="4" stroke-dasharray="2 9" stroke-linecap="round" />
      {stages.map(([label, x]) => (
        <>
          <circle cx={x} cy="120" r="26" fill="#5FD9B5" stroke={INK} stroke-width="3" />
          <path d={`M${Number(x) - 10} 120 l7 8 l14 -16`} fill="none" stroke={INK} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
          <text x={x} y="172" text-anchor="middle" fill={INK} style={`${mono};font-size:13px;font-weight:700`}>{label}</text>
        </>
      ))}
      <circle cx="340" cy="120" r="26" fill={INK} stroke="#FFAE8F" stroke-width="3" />
      <path d="M340 108 a12 12 0 1 1 -12 12" fill="none" stroke="#FFAE8F" stroke-width="4" stroke-linecap="round" />
      <text x="340" y="172" text-anchor="middle" fill={INK} style={`${mono};font-size:13px;font-weight:700`}>deploy</text>
      <text x="24" y="40" fill={INK} fill-opacity=".8" style={`${mono};font-size:13px`}>.github/workflows/ci.yml</text>
    </>
  )}

  {kind === "rust-para-backend" && (
    <>
      <polygon points={gear(255, 125, 78)} fill={INK} />
      <circle cx="255" cy="125" r="29.6" fill="#FFAE8F" />
      <polygon points={gear(140, 78, 44, 10)} fill="#E5484D" />
      <circle cx="140" cy="78" r="16.7" fill="#FFAE8F" />
      <polygon points={gear(128, 175, 30, 8)} fill="#FFFFFF" />
      <circle cx="128" cy="175" r="11.4" fill="#FFAE8F" />
      <rect x="24" y="186" width="168" height="34" rx="8" fill={INK} />
      <text x="38" y="208" fill="#FFD66B" style={`${mono};font-size:14px;font-weight:700`}>fn main() {"{ }"}</text>
    </>
  )}

  {kind === "code-review-eficaz" && (
    <>
      <rect x="34" y="26" width="300" height="190" rx="12" fill="#FFFFFF" stroke={INK} stroke-width="3" />
      <rect x="34" y="26" width="300" height="30" rx="12" fill={INK} />
      <rect x="34" y="44" width="300" height="12" fill={INK} />
      <text x="50" y="46" fill="#FFFFFF" style={`${mono};font-size:12px`}>pull/42 · diff</text>
      <rect x="48" y="70" width="190" height="12" rx="4" fill="#E8ECF1" />
      <rect x="48" y="92" width="160" height="12" rx="4" fill="#FFD0D3" />
      <text x="218" y="103" fill="#E5484D" style={`${mono};font-size:14px;font-weight:700`}>-</text>
      <rect x="48" y="114" width="210" height="12" rx="4" fill="#C9F5E4" />
      <text x="268" y="125" fill="#1F8F5F" style={`${mono};font-size:14px;font-weight:700`}>+</text>
      <rect x="48" y="136" width="140" height="12" rx="4" fill="#C9F5E4" />
      <text x="198" y="147" fill="#1F8F5F" style={`${mono};font-size:14px;font-weight:700`}>+</text>
      <rect x="48" y="158" width="180" height="12" rx="4" fill="#E8ECF1" />
      <rect x="48" y="180" width="120" height="12" rx="4" fill="#E8ECF1" />
      <g transform="translate(240 120)">
        <path d="M0 0 h130 a10 10 0 0 1 10 10 v46 a10 10 0 0 1 -10 10 h-96 l-16 14 v-14 h-18 a10 10 0 0 1 -10 -10 v-46 a10 10 0 0 1 10 -10z" fill="#C58AFF" stroke={INK} stroke-width="3" />
        <circle cx="22" cy="33" r="9" fill="#FFD66B" stroke={INK} stroke-width="2" />
        <rect x="40" y="22" width="80" height="8" rx="4" fill={INK} />
        <rect x="40" y="38" width="56" height="8" rx="4" fill={INK} opacity=".5" />
      </g>
    </>
  )}

  {kind === "microservicos-na-pratica" && (
    <>
      {micro.map(([x, y]) => <line x1="200" y1="120" x2={x} y2={y} stroke="#AAB2BF" stroke-width="2.5" stroke-dasharray="5 6" />)}
      <polygon points={hex(200, 120, 40)} fill="#91C8E4" stroke="#12151B" stroke-width="3" />
      {micro.map(([x, y, r, c]) => <polygon points={hex(x, y, r)} fill={c} stroke="#12151B" stroke-width="3" />)}
      <text x="200" y="125" text-anchor="middle" fill={INK} style={`${mono};font-size:13px;font-weight:700`}>api</text>
    </>
  )}

  {kind === "generic" && (
    <>
      <polygon points="200,40 290,196 110,196" fill="none" stroke={INK} stroke-width="4" />
      <polygon points="200,100 240,170 160,170" fill="#C58AFF" stroke={INK} stroke-width="3" />
      <text x="24" y="40" fill={INK} style={`${mono};font-size:13px;font-weight:700`}>#{tag.toLowerCase()}</text>
    </>
  )}
</svg>
)}
