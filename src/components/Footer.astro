---
import Logo from "./Logo.astro";
const { t } = Astro.props;
// O aviso só aparece quando o coletor de analytics está ligado
const tracking = Boolean(import.meta.env.PUBLIC_COLLECTOR_URL);
---

<footer class="site-footer">
  <div class="wrap">
    <span class="brand"><Logo size={22} id="ftr" /><span>yan<b>.dev</b></span></span>
    <span>© 2026 Yan Silva · {t.footer.made}</span>
    {tracking && <small class="privacy">{t.footer.privacy}</small>}
  </div>
</footer>

<style>
  .privacy { flex-basis: 100%; font-size: 13px; color: var(--muted); opacity: .85; }
</style>
