---
const { t } = Astro.props;
const c = t.contact;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const EMAIL = "yanvictorce@gmail.com";
const arrow = '<path d="M7 17 17 7M8 7h9v9"/>';
const channels = [
  { track: "linkedin", label: "LinkedIn", sub: "linkedin.com/in/yan-silva12", href: "https://linkedin.com/in/yan-silva12", icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>' },
  { track: "github", label: "GitHub", sub: "github.com/yanvic", href: "https://github.com/yanvic", icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>' },
  { track: "cv_download", label: c.resume, sub: c.resumeSub, href: `${base}/cv/curriculo.pdf`, icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6M9 15l3 3 3-3"/>' },
];
---

<section class="sec" id="contact">
  <div class="wrap">
    <div class="card-box contact" data-animate="fade-up">
      <div class="intro">
        <svg class="deco" viewBox="0 0 100 100" aria-hidden="true"><polygon points="50 8 92 82 8 82" fill="none" stroke="var(--warm)" stroke-width="3" /><polygon points="50 34 72 72 28 72" fill="var(--accent)" /></svg>
        <span class="status"><i></i>{c.status}</span>
        <h2>{c.title}</h2>
        <p>{c.text}</p>
        <dl class="facts">{c.facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
      </div>
      <div class="ch-col">
        <ul class="channels">
          <li>
            <div class="ch main">
              <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg></span>
              <div><b>{c.email}</b><small>{EMAIL}</small></div>
              <div class="acts">
                <button class="icon-btn" type="button" id="copy-email" data-track="email_copy" data-email={EMAIL} data-ok={c.copied} data-fail={c.copyFail} aria-label={c.copyEmail}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg></button>
                <a class="icon-btn" href={`mailto:${EMAIL}`} data-track="email_send" aria-label={c.sendEmail}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
              </div>
            </div>
          </li>
          {channels.map((ch) => (
            <li>
              <a class="ch" href={ch.href} target="_blank" rel="noopener" data-track={ch.track}>
                <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ch.icon} /></span>
                <div><b>{ch.label}</b><small>{ch.sub}</small></div>
                <span class="go"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></span>
              </a>
            </li>
          ))}
        </ul>
        <p class="hint" id="hint" role="status"></p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1.05fr; overflow: hidden; }
  .intro { padding: clamp(28px, 5vw, 56px); background: var(--plum); color: var(--t-text); display: flex; flex-direction: column; gap: 18px; position: relative; overflow: hidden; }
  .intro::before { content: ""; position: absolute; inset: 0; background: radial-gradient(70% 60% at 0% 100%, rgba(197, 138, 255, .22), transparent 70%), radial-gradient(60% 50% at 100% 0%, rgba(145, 200, 228, .18), transparent 70%); pointer-events: none; }
  .intro > * { position: relative; }
  .intro h2 { margin: 0; font-size: clamp(46px, 7vw, 84px); line-height: .92; letter-spacing: -.05em; font-weight: 800; color: #fff; }
  .intro p { margin: 0; color: var(--t-dim); font-size: 18px; max-width: 40ch; }
  .intro .status { background: rgba(255, 255, 255, .06); border-color: rgba(255, 255, 255, .14); color: var(--t-text); align-self: flex-start; }
  .facts { margin: auto 0 0; padding: 18px 0 0; border-top: 1px solid rgba(255, 255, 255, .14); display: grid; grid-template-columns: auto 1fr; gap: 8px 18px; font-size: 15px; }
  .facts dt { color: var(--t-dim); }
  .facts dd { margin: 0; color: #fff; font-weight: 600; }
  .intro .deco { position: absolute; right: -30px; top: -30px; width: 180px; height: 180px; opacity: .5; pointer-events: none; }
  .ch-col { display: flex; flex-direction: column; justify-content: center; }
  .channels { list-style: none; margin: 0; padding: clamp(12px, 3vw, 28px); }
  .channels li + li { border-top: 1px solid var(--line); }
  .ch { display: grid; grid-template-columns: 48px 1fr auto; align-items: center; gap: 16px; padding: 18px 10px; border-radius: 14px; text-decoration: none; transition: background .2s; }
  a.ch:hover { background: var(--paper2); }
  a.ch:hover .go { color: var(--accent-ink); transform: translate(2px, -2px); }
  .ch .ic { width: 48px; height: 48px; border-radius: 14px; background: var(--accent-soft); color: var(--accent-ink); display: flex; align-items: center; justify-content: center; }
  .ch b { display: block; font-size: 17px; }
  .ch small { display: block; color: var(--muted); font-size: 15px; overflow-wrap: anywhere; }
  .ch .go { color: var(--muted); display: flex; transition: transform .2s, color .2s; }
  .ch.main .ic { background: linear-gradient(135deg, var(--accent-2), var(--accent)); color: var(--on-accent); }
  .ch .acts { display: flex; gap: 8px; }
  .hint { min-height: 22px; margin: 0; padding: 0 clamp(22px, 4vw, 38px) 18px; font-family: var(--mono); font-size: 14px; color: var(--accent-ink); }
  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; }
    .intro .deco { top: auto; bottom: -40px; right: -40px; width: 150px; height: 150px; opacity: .35; }
    .ch small { font-size: 14px; }
    .ch .acts a { display: none; }
    .ch { grid-template-columns: 44px 1fr auto; gap: 12px; padding: 16px 4px; }
    .ch .ic { width: 44px; height: 44px; }
  }
</style>

<script>
  import { copyText } from "../../lib/client";

  function initContact() {
    const btn = document.getElementById("copy-email");
    const hint = document.getElementById("hint");
    if (!btn || !hint) return;
    btn.addEventListener("click", () => {
      const email = btn.dataset.email || "";
      copyText(email).then(
        () => { hint.textContent = btn.dataset.ok || ""; },
        () => { hint.textContent = (btn.dataset.fail || "") + email + "."; }
      );
    });
  }
  document.addEventListener("astro:page-load", initContact);
</script>
